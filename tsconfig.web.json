{
  "extends": "./tsconfig.base.json",
  "include": [
    "local/src/renderer/**/*",
    "src/renderer/src/**/*",
    "tests/__mocks__/**/*",
    "packages/aiCore/src/**/*",
    "packages/shared/**/*"
  ],
  "exclude": [
    "packages/aiCore/src/**/__tests__/**",
    "src/renderer/src/**/__tests__/**",
    "src/renderer/src/**/*.test.ts",
    "src/renderer/src/**/*.test.tsx",
    "src/renderer/src/**/*.spec.ts",
    "src/renderer/src/**/*.spec.tsx"
  ],
  "compilerOptions": {
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo/tsconfig.web.tsbuildinfo",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "moduleResolution": "bundler",
    "paths": {
      "@logger": ["./src/renderer/src/services/LoggerService"],
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./packages/shared/*"],
      "@types": ["./src/renderer/src/types/index.ts"],
      "@cherrystudio/ai-core": ["./packages/aiCore/src/index.ts"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  }
}
