{
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 920,
        "label": "main",
        "minHeight": 720,
        "minWidth": 1120,
        "resizable": true,
        "title": "lich13studio",
        "visible": false,
        "width": 1420
      }
    ],
    "withGlobalTauri": true
  },
  "build": {
    "frontendDist": "../out/renderer"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "targets": ["app", "dmg"]
  },
  "identifier": "com.lich13.studio",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ccswitch"]
      }
    }
  },
  "productName": "lich13studio",
  "version": "0.1.27"
}
